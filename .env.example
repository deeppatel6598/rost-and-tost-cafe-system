# Optional. Table QR codes normally auto-detect the domain from the
# incoming request, so you don't need to set this. Only set it if you want
# every QR code to point at one specific domain no matter where it's
# generated from (e.g. always your production domain).
# NEXT_PUBLIC_SITE_URL=https://your-live-domain.com

# Admin / Counter login (no database yet — credentials live in env vars).
# Change these before you go live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=roastandtoast123

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=change-this-to-a-long-random-string
