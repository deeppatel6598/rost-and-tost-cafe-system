# Required in production. Signs staff sessions, table session cookies AND the
# HMAC in every printed table QR code. Generate with: openssl rand -base64 32
#
# Two things to know:
#  - Leave this unset and the app falls back to a placeholder that is public in
#    this repository, which would let anyone forge a table code.
#  - Rotating it invalidates every printed QR sticker. That is the intended
#    lever if stickers are ever compromised, but plan a reprint.
AUTH_SECRET=change-this-to-a-long-random-string

# The canteen's own timezone. Opening hours are the times painted on the
# shutter — local campus time — but hosting runs in UTC, so this is what stops
# an 11:30am lunch rush being read as 06:00 and closing every stall.
CANTEEN_TIMEZONE=Asia/Kolkata

# Optional. Table QR codes normally encode whichever domain generated them.
# Set this to pin them to one domain regardless of where they were generated.
# NEXT_PUBLIC_SITE_URL=https://your-live-domain.com

# Seed staff passwords. Used only when the demo accounts are first created;
# change them here before the first deploy, or create real accounts from the
# supervisor screen and deactivate these.
SUPER_ADMIN_PASSWORD=canteen123
STALL_PASSWORD=stall123

# Order rate limits (per minute). The per-session cap is the meaningful one.
# Raise the per-IP cap if campus wifi puts many students behind one address.
# ORDER_RATE_LIMIT_PER_SESSION=8
# ORDER_RATE_LIMIT_PER_IP=200
