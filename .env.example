# Required in production. Signs staff sessions, table session cookies AND the
# HMAC in every printed table QR code. Generate with: openssl rand -base64 32
#
# Two things to know:
#  - In production the app refuses to start without it, and also refuses the
#    placeholder value shipped in this repository. In development it falls back
#    to that placeholder so the app runs out of the box.
#  - Rotating it invalidates every printed QR sticker. That is the intended
#    lever if stickers are ever compromised, but plan a reprint.
AUTH_SECRET=change-this-to-a-long-random-string

# The canteen's own timezone. Opening hours are the times painted on the
# shutter — local campus time — but hosting runs in UTC, so this is what stops
# an 11:30am lunch rush being read as 06:00 and closing every stall.
CANTEEN_TIMEZONE=Asia/Kolkata

# Optional. Table QR codes normally encode whichever domain generated them.
# Set this to pin them to one domain regardless of where they were generated.
# NEXT_PUBLIC_SITE_URL=https://your-live-domain.com

# Seed staff passwords. Used only when the demo accounts are first created;
# change them here before the first deploy, or create real accounts from the
# supervisor screen and deactivate these.
SUPER_ADMIN_PASSWORD=canteen123
STALL_PASSWORD=stall123

# Order rate limits (per minute). The per-session cap is the meaningful one.
# Raise the per-IP cap if campus wifi puts many students behind one address.
# These count orders created, not requests received: a phone retrying one
# checkout through a dropout does not spend the student's budget.
# ORDER_RATE_LIMIT_PER_SESSION=8
# ORDER_RATE_LIMIT_PER_IP=200

# Limits on "find my order" recovery, which is the one path that can be probed
# by someone guessing another student's phone number. Keep these tight.
# RECOVER_RATE_LIMIT_PER_SESSION=5
# RECOVER_RATE_LIMIT_PER_IP=30

# ── Database ──────────────────────────────────────────────────────────────
# Postgres connection string. Required in production.
#
# On serverless hosting (Netlify, Vercel) this MUST be the *pooled* string,
# not the direct one. A direct Postgres connection allows roughly sixty
# clients; a serverless platform spins up a function instance per concurrent
# request and will exhaust that during one lunch rush. Supabase's pooler
# multiplexes them.
#
#   pooled (use this):  ...@aws-0-<region>.pooler.supabase.com:6543/postgres
#   direct (avoid):     ...@db.<ref>.supabase.co:5432/postgres
#
# Find it in Supabase: Project Settings → Database → Connection string →
# "Transaction pooler". Reset the password there if you don't have it.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ── Phone verification ────────────────────────────────────────────────────
# Which channel sends one-time codes. "console" prints them to the server log
# and is for development only; "msg91" is the real one.
#
# Codes are NOT required to place an order — only to see sittings from another
# browser. That is deliberate: SMS in India can take 30 seconds or never
# arrive, and a telecom outage must never stop the canteen selling food.
#
# Most students never see a code at all. The browser that placed an order keeps
# seeing it, so a phone that moves between tables stays whole on its own; a
# code is only needed for a second device.
OTP_PROVIDER=console

# Required to use the console channel in production, which writes every
# student's code to the log. The app refuses to start otherwise. Only ever set
# this in a test environment.
# OTP_ALLOW_CONSOLE=1

# MSG91, over the DLT-registered transactional route. All three come out of DLT
# registration rather than the MSG91 dashboard:
#   MSG91_FLOW_ID    the approved template, whose text must match the DLT
#                    content template exactly. One variable: the code.
#   MSG91_SENDER_ID  the six-character DLT header, e.g. SKCANT
# Note that DLT registration is filed against a legal entity with a PAN, and
# that rotating the sender or template means re-approval, not just a redeploy.
# MSG91_AUTH_KEY=
# MSG91_FLOW_ID=
# MSG91_SENDER_ID=

# Spend controls. Every code costs money, so these are counted in Postgres
# rather than in process memory — an in-memory limit would multiply the bill by
# the number of running instances. The daily ceiling is a circuit breaker: on
# expected volume it should never be reached.
# OTP_SENDS_PER_PHONE_PER_HOUR=5
# OTP_SENDS_PER_DAY=500

# Request limits on the verification endpoints themselves.
# VERIFY_RATE_LIMIT_PER_SESSION=5
# VERIFY_RATE_LIMIT_PER_IP=40
# VERIFY_CHECK_LIMIT_PER_SESSION=12
# VERIFY_CHECK_LIMIT_PER_IP=100
