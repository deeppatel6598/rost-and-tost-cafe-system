# Public site URL — used to build the per-table QR code links.
# Set this to your live deployment URL once you have one.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin / Counter login (no database yet — credentials live in env vars).
# Change these before you go live.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=roastandtoast123

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=change-this-to-a-long-random-string
